# --- Speech to text: pick one ---
STT_PROVIDER=elevenlabs        # or sarvam
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# --- Answer generation ---
LLM_PROVIDER=groq              # groq | openai | anthropic
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Embeddings (local model, downloaded on first run) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval ---
VECTOR_INDEX_DIR=backend/data/index
TOP_K=5

# --- Guardrails ---
OFFTOPIC_SIM_THRESHOLD=0.28
GROUNDING_OVERLAP_THRESHOLD=0.15

# --- Dataset ---
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_CONFIG=hi
DATASET_SAMPLE_SIZE=1200
